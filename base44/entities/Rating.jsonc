{
  "name": "Rating",
  "type": "object",
  "properties": {
    "hike_id": {
      "type": "string",
      "description": "ID of the hike being rated"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the user who rated"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Rating from 1-5 stars"
    },
    "comment": {
      "type": "string",
      "description": "Optional comment with the rating"
    }
  },
  "required": [
    "hike_id",
    "user_email",
    "rating"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}